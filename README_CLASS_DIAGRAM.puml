@startuml
title ComunalExpenses2 — architecture

package "androidApp" {
    class MainActivity
    class ComunalExpensesApplication
    class QuickInputWidgetProvider
}

package "shared / ui" {
    class App
    class HomeScreen
    class AddResourcesDataScreen
    class SettingsScreen
    class StatsScreen
    sealed class AppRoute
}

package "shared / domain" {
    class ResourcesDataViewModel
    class SettingsViewModel
    class StatsCalculations <<pure functions>>
}

package "shared / data" {
    class ResourceDataRepository
    class ResourceDataDao
    interface SettingsManager
    class SettingsManagerImpl
    class ExportImport <<pure functions>>
    class ResourcesDatabase <<SQLDelight>>
}

package "shared / utils (expect/actual)" {
    class PlatformBackHandler
    class ShareUtils
    class FileExport
    class FilePicker
    class WidgetData
    class DateUtils
}

MainActivity --> App
MainActivity --> ResourcesDataViewModel
MainActivity --> SettingsViewModel

App --> HomeScreen
App --> AddResourcesDataScreen
App --> SettingsScreen
App --> StatsScreen
App --> AppRoute

HomeScreen --> ResourcesDataViewModel
AddResourcesDataScreen --> ResourcesDataViewModel
SettingsScreen --> ResourcesDataViewModel
SettingsScreen --> SettingsViewModel

StatsScreen --> StatsCalculations
ResourcesDataViewModel --> ResourceDataRepository
SettingsViewModel --> SettingsManager
ResourceDataRepository --> ResourceDataDao
ResourceDataDao --> ResourcesDatabase
ResourcesDataViewModel --> ExportImport
ResourcesDataViewModel --> WidgetData

HomeScreen --> ShareUtils
HomeScreen --> PlatformBackHandler
AddResourcesDataScreen --> PlatformBackHandler
SettingsScreen --> PlatformBackHandler
StatsScreen --> PlatformBackHandler
SettingsScreen --> FilePicker
SettingsScreen --> FileExport
HomeScreen --> DateUtils
StatsScreen --> DateUtils

QuickInputWidgetProvider ..> WidgetData : SharedPreferences + WIDGET_REFRESH broadcast

@enduml

@startuml
title ERD — resources_records

entity "resources_records" as resources {
    * recordId : TEXT <<PK>>
    --
    * date : INTEGER
    * waterHot : INTEGER
    * waterCold : INTEGER
    * electricityDay : INTEGER
    * electricityNight : INTEGER
    * shared : INTEGER
}

note right of resources
    date — ключ дня: UTC-полночь календарной даты
    UNIQUE(date): ровно одна карточка на календарный день
    shared — 0/1: запись отправлена и заблокирована от правки
    Единицы измерения задаются счётчиком (целые числа)
end note

@enduml

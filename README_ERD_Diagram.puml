@startuml
title Entity-Relationship Diagram for Communal Expenses Tracking

entity "ResourceRecord" as Resource {
    + recordId : TEXT (PK) - Unique ID for this usage instance
    --
    Date : INTEGER / Datestamp of measurement
    WaterHot : INTEGER / Hot water used (units)
    WaterCold : INTEGER / Cold water used (units)
    ElectricityDay : INTEGER / Day tariff electricity usage
    ElectricityNight : INTEGER / Night tariff electricity usage
}

' In this specific current schema, the entity is atomic (one table/one transaction).
' If there were separate tables for Users, Meters, or Tariffs, relationships would be drawn here.

@enduml